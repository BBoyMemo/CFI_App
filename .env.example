# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.
# Used by docker-compose.yml for the production stack (backend/appsettings.Development.json
# covers local development separately and already has its own dev-only defaults).

# --- Database ---
POSTGRES_DB=cfiAppDb
POSTGRES_USER=cfiapp
POSTGRES_PASSWORD=

# --- JWT signing key ---
# 64 random bytes, base64 encoded. Generate with:
#   openssl rand -base64 64
# Rotating this signs every existing session out - treat it like a password, not like
# configuration that gets casually regenerated.
JWT_SIGNING_KEY=
JWT_ISSUER=cfi-app
JWT_AUDIENCE=cfi-app

# --- Web origin ---
# The web app's real address, used for CORS. No trailing slash.
WEB_ORIGIN=https://app.example.com
