# Uploaded photos: Storage:RootPath = "storage", next to the API. On Windows that is the same
# folder as the Storage/ source code (names are case-insensitive), so everything in it is
# ignored except the source files.
/backend/src/DailyTasks.Api/[Ss]torage/*
