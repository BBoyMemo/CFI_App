# ---- Secrets / environment ----
# Never commit real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
appsettings.Production.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
firebase-service-account*.json

# TLS material. nginx.conf points at ./nginx/certs for the real certificate and its
# private key; nothing from there is ever committed.
nginx/certs/
*.pem
*.key
*.crt
*.csr

# ---- Uploads / generated data ----
uploads/
storage/
logs/
*.log

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
